# 环境变量配置示例
# 使用方式：cp docker/.env.example docker/.env  然后按需修改
# .env 文件需放在 docker/ 目录下（与 docker-compose.yml 同级）

# ── 数据库 ────────────────────────────────────────────────────────
# 不填则使用内置默认值（仅适合本地体验，正式环境请替换）
MYSQL_ROOT_PASSWORD=root123456
# docker-compose-server.yml 模式下对外暴露的端口（纯 Docker 模式不对外暴露）
MYSQL_PORT=3306

# ── 后端 ──────────────────────────────────────────────────────────
YUNYU_SERVER_NATIVE_IMAGE=ghcr.io/idea-flow/yunyu-server-native:latest
# # 不填则使用内置默认值（仅适合本地体验，正式环境请替换） 64 位随机字符串，生成命令：openssl rand -hex 32
YUNYU_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SPRING_PROFILES_ACTIVE=prod,native

# ── 后端端口（仅 docker-compose-server.yml 模式使用）────────────────
SERVER_PORT=20000

# ── 前端（仅 docker-compose.yml 纯 Docker 模式使用）────────────────
YUNYU_WEB_IMAGE=ghcr.io/idea-flow/yunyu-web:latest
# SSR 服务端调用后端的内部地址（容器内网），默认已指向 yunyu-server-native:20000，通常无需修改
# 仅在自定义容器名或网络时才需要覆盖
NUXT_YUNYU_API_BASE_INTERNAL=http://yunyu-server-native:20000
# 浏览器端 API 地址：纯 Docker 模式下前后端同域，浏览器通过 nginx 转发 /api/*，留空即可
# 若需要跨域访问后端，填写后端完整域名，如：https://api.yourdomain.com
YUNYU_PUBLIC_API_BASE=

# ── Nginx（仅 docker-compose.yml 纯 Docker 模式使用）───────────────
# nginx 对外监听的 HTTP 端口
NGINX_HTTP_PORT=89

# ── 通用 ──────────────────────────────────────────────────────────
TZ=Asia/Shanghai
